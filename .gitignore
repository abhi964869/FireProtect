# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
firmware/secrets.ini

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Data / runtime artefacts ------------------------------------------------
# The trained models and dataset ARE committed so a fresh clone runs without
# retraining. Runtime state is not.
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/thingspeak_buffer.jsonl
*.log

# --- Node --------------------------------------------------------------------
node_modules/
# frontend/dist is intentionally COMMITTED: it lets `python run_local.py` serve
# the dashboard on a machine with no Node toolchain. run_local.py rebuilds it
# automatically when the sources are newer, so it cannot silently go stale.
frontend/.vite/
npm-debug.log*

# --- PlatformIO --------------------------------------------------------------
firmware/.pio/
firmware/.vscode/
firmware/_parity_harness*

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
