# FireProtect environment configuration.
#
#   cp .env.example .env
#
# Everything here has a working default — the stack runs with no .env at all.
# Values are read by backend/app/config.py (Pydantic Settings) and by
# docker-compose.yml.
#
# NEVER commit a filled-in .env. It is git-ignored.

# ---------------------------------------------------------------------------
# MQTT broker
# ---------------------------------------------------------------------------
# Inside docker compose this is the service name; running the backend directly
# on your machine, use localhost.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=fireprotect-backend
MQTT_TOPIC_PREFIX=fireprotect
# Leave blank for an anonymous broker (the bundled Mosquitto config allows it).
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Four slashes = absolute path. Three = relative to the working directory.
DATABASE_URL=sqlite:///./backend/fireprotect.db
RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Where random_forest.joblib and feature_columns.json live. If the model is
# missing the backend still runs, falling back to threshold rules.
MODEL_DIR=./ml

# ---------------------------------------------------------------------------
# ThingSpeak cloud mirror (optional)
# ---------------------------------------------------------------------------
# Disabled by default. No key is needed for tests — the HTTP transport is
# mocked. Get a write key from https://thingspeak.com/channels/<id>/api_keys
THINGSPEAK_ENABLED=false
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_URL=https://api.thingspeak.com/update
# The free tier rejects updates faster than one per 15 s.
THINGSPEAK_MIN_INTERVAL_S=15
THINGSPEAK_MAX_RETRIES=4
THINGSPEAK_BUFFER_PATH=./backend/thingspeak_buffer.jsonl
THINGSPEAK_BUFFER_MAX_ENTRIES=5000

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Seconds of silence before a device is marked offline.
DEVICE_OFFLINE_AFTER_S=30
# Consecutive classifications required before an alert is raised. FIRE is kept
# low (2 samples = 4 s) so a real fire is not delayed; 1 would alarm on noise.
FIRE_ALERT_CONSECUTIVE=2
WARNING_ALERT_CONSECUTIVE=3

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Loopback by default: the API is unauthenticated and can change alert
# thresholds and delete data. Only set 0.0.0.0 when you intend to serve real
# devices on a LAN — and put authentication in front of it first.
API_HOST=127.0.0.1
API_PORT=8000

# Reject WebSocket handshakes from unknown origins (cross-site WebSocket
# hijacking). Leave true unless you have a specific reason not to.
WEBSOCKET_STRICT_ORIGIN=true

# Origins allowed to call the API and open the WebSocket. Accepts a bare URL,
# a comma-separated list, or a JSON array — whichever your host's env var box
# makes easiest:
#   CORS_ORIGINS=https://fireprotect.vercel.app
#   CORS_ORIGINS=https://a.vercel.app,http://localhost:5173
#   CORS_ORIGINS=["https://a.vercel.app"]
# CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Generate telemetry inside the backend, so a deployed dashboard is populated
# with no ESP32 and nobody running the simulator. Readings go through the real
# pipeline — same validation, same model, same alerting.
#
# OFF by default on purpose: a deployment with real sensors must never have
# synthetic readings mixed into its history.
DEMO_MODE=false
DEMO_DEVICE_ID=esp32-demo-01
DEMO_LOCATION=Demo Living Room
DEMO_INTERVAL_S=2.0
# Simulated seconds per tick. Above DEMO_INTERVAL_S, events replay faster than
# real time so a visitor sees a fire develop in ~1 min rather than ~3.
DEMO_SIM_STEP_S=4.0

# ---------------------------------------------------------------------------
# Frontend (Vite, build-time)
# ---------------------------------------------------------------------------
# Leave unset for same-origin requests via the dev proxy / nginx. Set only when
# the dashboard is served from a different host than the API.
# VITE_API_BASE=http://192.168.1.10:8000

# ---------------------------------------------------------------------------
# Simulator (docker compose --profile demo)
# ---------------------------------------------------------------------------
SIM_SCENARIO=normal
SIM_DEVICE_ID=esp32-sim-01
SIM_LOCATION=Simulated Room
