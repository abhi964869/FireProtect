; Copy this file to `secrets.ini` and fill it in before flashing hardware.
; `secrets.ini` is git-ignored - never commit real credentials.

[secrets]
; --- Wi-Fi ---
wifi_ssid = YourNetworkName
wifi_password = YourNetworkPassword

; --- MQTT broker ---
; Use the LAN IP of the machine running docker-compose, not "localhost":
; the ESP32 resolves this on its own network stack.
mqtt_host = 192.168.1.100
mqtt_port = 1883
; Leave blank for an anonymous broker (the bundled Mosquitto config allows it).
mqtt_username =
mqtt_password =

; --- Device identity ---
; Must be unique per device: it becomes the MQTT topic segment
; (fireprotect/<device_id>/telemetry) and the primary key in the database.
device_id = esp32-01
device_location = Kitchen

; --- ThingSpeak (optional) ---
; Leave blank to disable cloud mirroring entirely.
thingspeak_api_key =
