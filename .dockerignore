# Keep the build context small and secrets out of images.

.git
.github
**/node_modules
**/__pycache__
**/*.pyc
.venv
venv
.mypy_cache
.ruff_cache
.pytest_cache
htmlcov
.coverage*

# Secrets — never in an image layer.
.env
.env.*
!.env.example
firmware/secrets.ini

# Runtime state.
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/thingspeak_buffer.jsonl
*.log

# Not needed at runtime.
firmware/.pio
docs
*.md
!README.md
ml/dataset.csv
